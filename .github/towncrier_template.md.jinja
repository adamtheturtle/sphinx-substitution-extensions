{# Preserve semantic lines in fragments and keep issue links on a separate line. #}
{%- set newline = "\n" -%}
{{- "# " ~ versiondata.version ~ " (" ~ versiondata.date ~ ")" ~ newline ~ newline }}
{%- for section, categories in sections.items() %}
    {%- if section %}
        {{- "## " ~ section ~ newline ~ newline }}
    {%- endif %}
    {%- for category, definition in definitions.items() if category in categories %}
        {{- ("### " if section else "## ") ~ definition.name ~ newline ~ newline }}
        {%- for text, issues in categories[category].items() %}
            {%- if text %}
                {{- text.replace("\n  ", "\n") if text.startswith("- ") else "- " ~ text }}
                {%- if issues %}
                    {%- set separate_paragraph = "\n  - " in text or "\n  * " in text or not text.rstrip().endswith((".", "!", "?")) %}
                    {{- newline ~ (newline if separate_paragraph else "") ~ "  (" ~ issues | join(", ") ~ ")" }}
                {%- endif %}
            {%- elif issues %}
                {{- "- " ~ issues | join(", ") }}
            {%- endif %}
            {{- newline }}
        {%- endfor %}
        {{- newline }}
    {%- else %}
        {{- "No significant changes." ~ newline ~ newline }}
    {%- endfor %}
{%- endfor %}
